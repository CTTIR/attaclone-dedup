{
  "manifest_version": 2,
  "name": "Attaclone-dedup",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Find verified duplicate attachments; preview by default and move reviewed copies to Zotero Trash.",
  "homepage_url": "https://github.com/CTTIR/attaclone-dedup",
  "author": "Raban",
  "icons": {
    "48": "content/icons/icon.png",
    "96": "content/icons/icon@2x.png"
  },
  "applications": {
    "zotero": {
      "id": "attaclone-dedup@r-heller.github.io",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
